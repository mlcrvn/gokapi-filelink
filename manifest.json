{
  "manifest_version": 3,
  "name": "FileLink for Gokapi",
  "description": "Utilisez votre instance Gokapi comme fournisseur FileLink dans Thunderbird.",
  "version": "1.0.0",
  "author": "Mathieu Lécrivain",
  "homepage_url": "https://github.com/mlcrvn/gokapi-filelink",
  "icons": {
    "16": "icons/gokapi.svg",
    "32": "icons/gokapi.svg",
    "64": "icons/gokapi.svg",
    "96": "icons/gokapi.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gokapi-filelink@mlcrvn.net",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "gokapi.js",
      "background.js"
    ]
  },
  "cloud_file": {
    "name": "Gokapi",
    "management_url": "management.html",
    "browser_style": false,
    "reuse_uploads": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ]
}
